# ===========================================================================
# Company Brain Lite — environment variables
# Copy to `.env.local` (web) and `.env` (worker) and fill in real values.
# Every variable the app reads is documented here.
# ===========================================================================

# ---- Supabase ----
# Project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
# Anon (publishable) key — safe for the browser
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server/worker ONLY, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# ---- LLM / Embeddings / Rerank ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
COHERE_API_KEY=
# Optional: unstructured.io API for richer document parsing. If unset, the
# app falls back to pdf-parse / mammoth / raw text.
UNSTRUCTURED_API_KEY=
UNSTRUCTURED_API_URL=https://api.unstructured.io/general/v0/general

# ---- Google Drive connector ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/connections/google/callback

# ---- Slack connector ----
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_REDIRECT_URI=http://localhost:3000/api/connections/slack/callback

# ---- Redis / BullMQ ----
REDIS_URL=redis://localhost:6379

# ---- Encryption (AES-256-GCM) ----
# 32-byte key, hex-encoded (64 hex chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ---- Stripe (optional — feature-flagged) ----
# Leave BILLING_ENABLED=false to run without Stripe locally.
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_TEAM=

# ---- Observability (optional) ----
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ---- App ----
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
